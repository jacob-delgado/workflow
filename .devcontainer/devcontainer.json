{
  "name": "workflow",
  // The image and the feature are pinned by digest, as build/Dockerfile's base
  // image is, so what a new container starts from cannot change under a
  // re-pushed tag. Each moves to a new digest, by Dependabot's devcontainers
  // entry or by hand, once that digest is past the week-long age gate.
  "image": "mcr.microsoft.com/devcontainers/base:2.2.3-trixie@sha256:6ee2b4097c75d33e9a94d941577a3286e5d629434fba384688b06daeeaaeac99",
  "features": {
    // Lets `task container:check` and `task container:release` run their build
    // container from inside this one. Version 4.1.3, by digest.
    "ghcr.io/devcontainers/features/docker-in-docker@sha256:fae40f3c8be5a7c3b0db344c1d30341bc2c91ba38d1d5b14cd2ad72e6d65d084": {
      "moby": true
    }
  },
  "postCreateCommand": ".devcontainer/postCreate.sh",
  "containerEnv": {
    // Match mise.toml: never silently download a different Go toolchain.
    "GOTOOLCHAIN": "local"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "EditorConfig.EditorConfig",
        "task.vscode-task",
        "hverlin.mise-vscode",
        "timonwong.shellcheck",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "go.lintTool": "golangci-lint-v2",
        "gopls": {
          "formatting.gofumpt": true
        },
        "editor.formatOnSave": true
      }
    },
    "jetbrains": {
      "backend": "GoLand"
    }
  },
  "remoteUser": "vscode"
}
