# --- Go ---
/bin/
/dist/
*.test
*.out
*.prof
coverage.out
coverage.html

# --- Web frontend (web/) ---
# node_modules and the Vite build output are generated. The build lands in
# internal/web/dist, where the binary embeds it under the `embedui` tag (see
# internal/web); neither the output nor the embed directory is committed.
web/node_modules/
web/dist/
internal/web/dist/
web/coverage/
web/test-results/
web/playwright-report/
web/blob-report/
web/.vite/
# Yarn Berry keeps its pinned release and lockfile tracked; ignore the rest.
web/.yarn/*
!web/.yarn/patches
!web/.yarn/plugins
!web/.yarn/releases
!web/.yarn/sdks
!web/.yarn/versions
web/.pnp.*

# --- Local configuration ---
# A real .workflow.json holds live Jira and Slack tokens. Never commit one;
# `workflow config init` writes it at 0600 for exactly this reason.
.workflow.json
.env
.env.*
!.env.example

# mise local overrides (personal pins, machine-specific env).
mise.local.toml
.mise.local.toml

# --- Documentation site (Hugo) ---
docs/public/
docs/resources/
docs/.hugo_build.lock

# --- Scratch ---
tmp/
.task/

# --- Claude Code ---
# The whole directory: it holds per-machine settings and session state such as
# scheduled_tasks.lock, none of which belongs to the project.
.claude/
CLAUDE.local.md

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# --- Windows ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Linux ---
.directory
.Trash-*
.nfs*
.fuse_hidden*

# --- JetBrains (GoLand / IntelliJ) ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- VS Code ---
.vscode/
*.code-workspace

# --- Vim ---
*.swp
*.swo
*.swn
Session.vim
.netrwhist
tags

# --- Emacs ---
*~
\#*\#
.\#*
.emacs.desktop
.emacs.desktop.lock
auto-save-list/
tramp
