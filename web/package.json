{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "gen": "openapi-ts",
    "gen:check": "openapi-ts && ../scripts/check-generated.sh src/api/generated \"The generated client is out of date. Run 'yarn gen' and commit src/api/generated.\"",
    "lint": "eslint . && tsc -b && prettier --check . && knip && yarn lint:deps",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "fmt": "prettier --write .",
    "knip": "knip",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:server": "playwright test -c playwright.server.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "resolutions": {
    "js-yaml": "^4.3.2"
  }
}
