{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    /* `@/` is the src root, declared here alone: Vite, Vitest and the test
       project read it from this file. No "baseUrl": TS 6 deprecates it, and
       relative path targets don't need it. */
    "paths": { "@/*": ["./src/*"] },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* The tests and their helpers are tsconfig.test.json's, which adds Vitest's
     globals, so a stray expect() in the app does not compile. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test", "src/test-setup.ts"]
}
